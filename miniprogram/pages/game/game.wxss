page {
  height: 100vh;
  overflow: hidden;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 34rpx;
  box-sizing: border-box;
}

.nav {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 26rpx;
}

.nav-back {
  width: 72rpx;
  font-size: 54rpx;
  line-height: 1;
  color: #6B5D52;
  padding-bottom: 8rpx;
}

.nav-center {
  flex: 1;
  text-align: center;
}

.nav-code {
  font-size: 23rpx;
  letter-spacing: 3rpx;
  color: #8C7C6D;
}

.nav-right {
  width: 72rpx;
  text-align: right;
  font-size: 26rpx;
  letter-spacing: 1rpx;
  color: #B4584C;
}

.nav-right.muted {
  font-size: 21rpx;
  color: #C0B2A4;
}

.players {
  width: 100%;
  height: 56rpx;
  padding: 0 34rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}

.player {
  display: flex;
  align-items: center;
  min-width: 130rpx;
}

.player.right {
  justify-content: flex-end;
}

.chip {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
}

.chip.black {
  background: radial-gradient(circle at 34% 30%, #6E6A66 0%, #2B2724 45%, #12100E 100%);
}

.chip.white {
  background: radial-gradient(circle at 34% 30%, #FFFFFF 0%, #F7F1E8 50%, #DDD2C2 100%);
  box-shadow: inset 0 0 0 1rpx rgba(150, 128, 108, 0.4);
}

.who {
  font-size: 24rpx;
  line-height: 34rpx;
  color: #7D6C5E;
  margin: 0 10rpx;
  letter-spacing: 1rpx;
}

.player.active .who {
  color: #B4584C;
  font-weight: 600;
}

.status {
  font-size: 21rpx;
  color: #A0917F;
  letter-spacing: 1rpx;
}

.board-wrap {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
  width: 100%;
}

.board {
  position: relative;
  background: linear-gradient(158deg, #EDD6B8 0%, #E2C39C 100%);
  border-radius: 16rpx;
  box-shadow: inset 0 0 0 2rpx rgba(140, 100, 66, 0.22), 0 14rpx 32rpx rgba(120, 88, 60, 0.14);
}

.line {
  position: absolute;
  background: rgba(122, 88, 58, 0.32);
}

.line.v {
  top: 3.333%;
  height: 93.334%;
  width: 1px;
}

.line.h {
  left: 3.333%;
  width: 93.334%;
  height: 1px;
}

.star {
  position: absolute;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: rgba(104, 72, 46, 0.55);
  transform: translate(-50%, -50%);
}

.stone {
  position: absolute;
  width: 6.2%;
  height: 6.2%;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.stone.black {
  background: radial-gradient(circle at 34% 28%, #74706B 0%, #2C2825 44%, #0E0C0A 100%);
  box-shadow: 0 2rpx 6rpx rgba(30, 20, 12, 0.35);
}

.stone.white {
  background: radial-gradient(circle at 34% 28%, #FFFFFF 0%, #F8F3EA 46%, #DCD1C1 100%);
  box-shadow: 0 2rpx 6rpx rgba(90, 70, 50, 0.22), inset 0 0 0 1rpx rgba(160, 140, 120, 0.35);
}

.stone.win {
  animation: stonePulse 1.3s ease-in-out infinite;
}

@keyframes stonePulse {
  0%,
  100% {
    box-shadow: 0 0 0 0 rgba(180, 88, 76, 0.55);
  }
  50% {
    box-shadow: 0 0 0 10rpx rgba(180, 88, 76, 0);
  }
}

.last-mark {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 26%;
  height: 26%;
  border-radius: 50%;
  background: #C25F55;
  transform: translate(-50%, -50%);
}

.stone.preview {
  opacity: 0.55;
  box-shadow: 0 0 0 3rpx rgba(180, 88, 76, 0.5);
}

/* 乐观渲染的待确认子：实心但轻微呼吸，服务器确认后自动变回普通子 */
.stone.pending {
  animation: stonePendingPulse 0.9s ease-in-out infinite alternate;
}

@keyframes stonePendingPulse {
  0% {
    opacity: 0.72;
  }
  100% {
    opacity: 1;
  }
}

.chip-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chip {
  position: relative;
  z-index: 2;
}

/* 火势舞台：常驻挂载，档位只改 class。
   尺寸/显隐全部走 transform + opacity 过渡，切换档位时是生长/消退，不是闪现 */
.fire-stage {
  position: absolute;
  left: 50%;
  bottom: 12rpx;
  width: 110rpx;
  height: 96rpx;
  margin-left: -55rpx;
  z-index: 1;
  pointer-events: none;
  transform-origin: 50% 100%;
  transition: transform 0.5s cubic-bezier(0.34, 1.45, 0.64, 1), opacity 0.4s ease,
    filter 0.5s ease;
}

.fire-stage.lv0 {
  opacity: 0;
  transform: scale(0.45) translateY(12rpx);
}

.fire-stage.lv1 {
  opacity: 0.95;
  transform: scale(0.62);
}

.fire-stage.lv2 {
  opacity: 1;
  transform: scale(0.82);
  filter: drop-shadow(0 0 6rpx rgba(240, 120, 50, 0.4));
}

.fire-stage.lv3 {
  opacity: 1;
  transform: scale(1);
  filter: drop-shadow(0 0 10rpx rgba(240, 120, 50, 0.65));
}

/* 三苗常驻：主苗一直在，侧苗只在 L3 淡入 */
.chip-fire {
  position: absolute;
  bottom: 0;
  pointer-events: none;
  transform-origin: 50% 100%;
  animation-name: chipFlame;
  animation-duration: 1.15s;
  animation-iteration-count: infinite;
  animation-timing-function: ease-in-out;
  animation-direction: alternate;
  animation-fill-mode: both;
  transition: opacity 0.45s ease;
}

.chip-fire.f-main {
  left: 50%;
  margin-left: -24rpx;
  width: 48rpx;
  height: 76rpx;
}

.chip-fire.f-side {
  width: 34rpx;
  height: 54rpx;
  opacity: 0;
}

.chip-fire.f-side.l {
  left: 12rpx;
  animation-delay: 0.18s;
}

.chip-fire.f-side.r {
  right: 12rpx;
  animation-delay: 0.34s;
}

.fire-stage.lv2 .chip-fire {
  animation-duration: 0.8s;
}

/* L2 两朵：藏主苗、亮左右侧苗；L3 三苗：主苗补回 */
.fire-stage.lv2 .chip-fire.f-main {
  opacity: 0;
}

.fire-stage.lv2 .chip-fire.f-side,
.fire-stage.lv3 .chip-fire.f-side {
  opacity: 0.95;
}

.fire-stage.lv3 .chip-fire {
  animation-name: chipFlameRage;
  animation-duration: 0.5s;
}

/* 光晕只在 L3 出现，淡入后接脉冲 */
.fire-glow {
  position: absolute;
  left: 50%;
  bottom: -8rpx;
  width: 90rpx;
  height: 90rpx;
  margin-left: -45rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 170, 90, 0.42) 0%, rgba(255, 170, 90, 0) 70%);
  opacity: 0;
  transition: opacity 0.5s ease;
  pointer-events: none;
}

.fire-stage.lv3 .fire-glow {
  opacity: 1;
  animation: glowPulse 0.9s ease-in-out infinite alternate;
}

@keyframes glowPulse {
  0% {
    opacity: 0.55;
    transform: scale(0.85);
  }
  100% {
    opacity: 1;
    transform: scale(1.15);
  }
}

/* 摆动只动 transform，opacity 留给档位过渡 */
@keyframes chipFlame {
  0% {
    transform: scaleY(0.9) skewX(-3deg);
  }
  50% {
    transform: scaleY(1.08) skewX(2deg);
  }
  100% {
    transform: scaleY(0.98) skewX(4deg);
  }
}

@keyframes chipFlameRage {
  0% {
    transform: scaleY(0.82) skewX(-6deg) scaleX(0.94);
  }
  25% {
    transform: scaleY(1.12) skewX(4deg) scaleX(1.04);
  }
  50% {
    transform: scaleY(0.9) skewX(-2deg) scaleX(0.98);
  }
  75% {
    transform: scaleY(1.15) skewX(6deg) scaleX(1.06);
  }
  100% {
    transform: scaleY(0.88) skewX(-4deg) scaleX(0.96);
  }
}

.waiting {
  margin-top: 32rpx;
  width: 100%;
  padding: 0 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.waiting-label {
  font-size: 21rpx;
  letter-spacing: 6rpx;
  color: #A0917F;
}

.waiting-code {
  margin-top: 6rpx;
  font-size: 76rpx;
  line-height: 1.2;
  font-weight: 600;
  letter-spacing: 16rpx;
  color: #3B322C;
}

.waiting-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9C8E82;
  letter-spacing: 1rpx;
}

.waiting-cancel {
  margin-top: 26rpx;
  font-size: 22rpx;
  color: #B4A494;
  letter-spacing: 1rpx;
}

.controls {
  position: relative;
  width: 100%;
  margin-top: 8rpx;
  height: 66rpx;
  padding-top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.confirm-layer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: #FAF6F0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ghost {
  height: 66rpx;
  padding: 0 32rpx;
  margin: 0 10rpx;
  border-radius: 33rpx;
  border: 1rpx solid #E3D4C6;
  color: #8C7C6D;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn {
  width: 460rpx;
  height: 92rpx;
  margin-top: 26rpx;
  border-radius: 46rpx;
  font-size: 28rpx;
  letter-spacing: 3rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background: #B4584C;
  color: #FFF7F1;
  box-shadow: 0 10rpx 24rpx rgba(180, 88, 76, 0.22);
}

.btn-waiting {
  background: #F0E7DE;
  color: #A6937F;
}

.btn-quiet {
  background: transparent;
  color: #A99A8A;
  font-size: 22rpx;
  height: 68rpx;
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}

.ghost-off {
  color: #C6B7A8;
  border-color: #EFE4D8;
}

.ghost-on {
  color: #B4584C;
  border-color: #E7C9BE;
  background: #FDF3EE;
}

.ghost-wide {
  width: 220rpx;
  padding: 0;
}

.ghost.confirm {
  background: #B4584C;
  border-color: #B4584C;
  color: #FFF7F1;
  box-shadow: 0 8rpx 18rpx rgba(180, 88, 76, 0.22);
}

.ghost.off {
  opacity: 0.55;
}

.hint-ring {
  position: absolute;
  width: 7.2%;
  height: 7.2%;
  border-radius: 50%;
  border: 2rpx solid #C25F55;
  background: rgba(194, 95, 85, 0.16);
  transform: translate(-50%, -50%);
  animation: hintRipple 1.4s ease-out forwards;
  pointer-events: none;
}

@keyframes hintRipple {
  0% {
    opacity: 0.95;
    transform: translate(-50%, -50%) scale(0.5);
  }
  60% {
    opacity: 0.6;
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(2.2);
  }
}

.msg-area {
  width: 100%;
  height: 156rpx;
  padding: 6rpx 34rpx 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex-shrink: 0;
}

.msg-row {
  height: 72rpx;
  display: flex;
  align-items: flex-end;
}

.msg-row.right {
  justify-content: flex-end;
}

.msg-bubble {
  max-width: 88%;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: rgba(255, 253, 251, 0.95);
  border: 1rpx solid #EFE3D7;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #3B322C;
  letter-spacing: 1rpx;
  overflow: hidden;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.msg-bubble.mine {
  color: #B4584C;
  border-color: #E9CFC4;
}

.panel-slot {
  width: 100%;
  height: 380rpx;
  padding: 0 34rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.word-panel {
  width: 100%;
  height: 100%;
  padding: 14rpx 16rpx;
  box-sizing: border-box;
  background: #FFFDFB;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(120, 92, 70, 0.06);
  display: flex;
  flex-direction: column;
}

.draft-row {
  height: 52rpx;
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.draft-scroll {
  flex: 1;
  height: 52rpx;
  line-height: 52rpx;
  white-space: nowrap;
}

.draft-inner {
  display: inline-block;
  white-space: nowrap;
  font-size: 26rpx;
  line-height: 52rpx;
  color: #3B322C;
  letter-spacing: 1rpx;
}

.draft-inner.ph {
  font-size: 23rpx;
  color: #C4B5A6;
}

.draft-count {
  margin-left: 16rpx;
  font-size: 21rpx;
  color: #B4A494;
  flex-shrink: 0;
}

.char-grid {
  height: 216rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-content: space-between;
  margin-bottom: 10rpx;
}

.char {
  width: calc((100% - 56rpx) / 8);
  height: 68rpx;
  border-radius: 12rpx;
  background: #FAF3EC;
  color: #5E5045;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.char:active {
  background: #F3E5D8;
}

.panel-actions {
  height: 60rpx;
  display: flex;
  align-items: center;
}

.act {
  height: 60rpx;
  padding: 0 24rpx;
  margin-right: 12rpx;
  border-radius: 30rpx;
  font-size: 23rpx;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.act.ghost {
  border: 1rpx solid #E7D9CB;
  color: #8C7C6D;
}

.act.send {
  margin-left: auto;
  margin-right: 0;
  width: 200rpx;
  background: #B4584C;
  color: #FFF7F1;
}

.act.off {
  opacity: 0.42;
}

.undo-bar {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  padding: 16rpx 18rpx 16rpx 28rpx;
  background: #FFFDFB;
  border-radius: 999rpx;
  box-shadow: 0 12rpx 36rpx rgba(70, 50, 36, 0.18);
  z-index: 50;
}

.undo-text {
  font-size: 23rpx;
  color: #5E5045;
  letter-spacing: 1rpx;
  margin-right: 18rpx;
  white-space: nowrap;
}

.undo-btn {
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #9C8E82;
  letter-spacing: 1rpx;
}

.undo-btn.main {
  background: #B4584C;
  color: #FFF7F1;
  margin-right: 6rpx;
}

.hint {
  margin-top: 160rpx;
  font-size: 24rpx;
  color: #A0917F;
  text-align: center;
  padding: 0 60rpx;
  line-height: 1.8;
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(46, 38, 32, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.result-card {
  width: 556rpx;
  background: #FFFDFB;
  border-radius: 36rpx;
  padding: 50rpx 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 24rpx 64rpx rgba(50, 38, 30, 0.2);
}

.result-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-bottom: 28rpx;
}

.result-icon.win {
  background: radial-gradient(circle at 34% 28%, #74706B 0%, #2C2825 44%, #0E0C0A 100%);
  box-shadow: 0 0 0 10rpx rgba(180, 88, 76, 0.12);
}

.result-icon.lose {
  background: radial-gradient(circle at 34% 28%, #FFFFFF 0%, #F8F3EA 46%, #DCD1C1 100%);
  box-shadow: 0 0 0 10rpx rgba(150, 128, 108, 0.12);
}

.result-icon.draw {
  background: linear-gradient(90deg, #2C2825 0%, #2C2825 50%, #F6F0E7 50%, #F6F0E7 100%);
  box-shadow: inset 0 0 0 1rpx rgba(150, 128, 108, 0.25);
}

.result-icon.closed {
  background: #E7DCD0;
}

.result-title {
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  color: #3B322C;
}

.result-desc {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #9C8E82;
  letter-spacing: 1rpx;
  text-align: center;
}

.result-card .btn {
  width: 100%;
}
